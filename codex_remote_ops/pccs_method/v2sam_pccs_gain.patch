new file mode 100644
--- /dev/null
+++ b/tests/test_context_consistency.py
@@ -0,0 +1,65 @@
+"""Numerical and routing contracts; runnable without MMEngine/SAM weights."""
+import importlib.util
+from pathlib import Path
+import unittest
+import torch
+
+spec = importlib.util.spec_from_file_location('context', Path(__file__).parents[1] /
+    'projects/v2sam_pccs/context_consistency.py')
+c = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(c)
+
+
+class ContextTests(unittest.TestCase):
+    def setUp(self):
+        self.f = torch.zeros(3,16,24)
+        self.f[0] = 1
+        self.m = torch.zeros(160,240)
+        self.m[60:100,80:120] = 1
+
+    def test_empty_full_and_nonfinite_are_invalid(self):
+        for m in (torch.zeros_like(self.m), torch.ones_like(self.m)):
+            self.assertIsNone(c.context_descriptor(self.f,m)[0])
+        self.assertIsNone(c.context_descriptor(self.f*float('nan'),self.m)[0])
+
+    def test_constant_and_opposite_context(self):
+        row = c.score_context(self.f, -self.f, self.m[None], {'visual':self.m[None]})[0]
+        self.assertAlmostEqual(row['scores']['visual'], -1, places=6)
+        self.assertIsNone(row['scores']['anchor'])
+
+    def test_foreground_does_not_contaminate_ring(self):
+        a,_ = c.context_descriptor(self.f,self.m)
+        changed = self.f.clone()
+        changed[:,6:10,8:12] = 100
+        b,_ = c.context_descriptor(changed,self.m)
+        torch.testing.assert_close(a,b)
+
+    def test_normalized_coordinates_on_different_mask_resolution(self):
+        a,_ = c.context_descriptor(self.f,self.m)
+        b,_ = c.context_descriptor(self.f,self.m.repeat_interleave(2,0).repeat_interleave(2,1))
+        torch.testing.assert_close(a,b)
+
+    def test_baseline_and_missing_evidence(self):
+        e={'scores':{'fusion':0.1,'visual':0.9,'anchor':None}}
+        self.assertEqual(c.select_context('fusion',e,c.EXPERTS,weight=0)[0],'fusion')
+        self.assertEqual(c.select_context('anchor',e,c.EXPERTS)[0],'anchor')
+        self.assertEqual(c.select_context('fusion',e,['fusion'])[0],'fusion')
+        self.assertEqual(c.select_context('fusion',e,c.EXPERTS)[0],'visual')
+
+    def test_ties_negative_cosines_and_nonfinite(self):
+        e={'scores':{'fusion':-0.8,'visual':-0.8,'anchor':float('nan')}}
+        self.assertEqual(c.select_context('fusion',e,c.EXPERTS,margin=0)[0],'fusion')
+        e['scores']['visual']=-0.5
+        self.assertEqual(c.select_context('fusion',e,c.EXPERTS)[0],'visual')
+
+    def test_invalid_parameters(self):
+        for w in (-1,float('nan'),float('inf')):
+            with self.assertRaises(ValueError): c.select_context('fusion',{},[],weight=w)
+
+    def test_no_annotation_argument(self):
+        import inspect
+        self.assertNotIn('gt',str(inspect.signature(c.score_context)))
+        self.assertNotIn('gt',str(inspect.signature(c.select_context)))
+
+
+if __name__ == '__main__': unittest.main()
