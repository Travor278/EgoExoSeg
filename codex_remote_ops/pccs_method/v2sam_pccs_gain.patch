--- /dev/null
+++ b/projects/v2sam_pccs/context_consistency.py
@@ -0,0 +1,103 @@
+"""Frozen-feature context diagnostics and prediction-only PCCS rerouting.
+
+No target annotations, fitted parameters, or additional encoder passes are used.
+Scores are signed cosine similarities. Invalid evidence preserves the baseline.
+"""
+import math
+
+import torch
+import torch.nn.functional as F
+
+EXPERTS = ("visual", "anchor", "fusion")
+
+
+def context_descriptor(features, mask, expansion=2.0, min_patches=4.0):
+    """Pool an expanded bounding box minus foreground in DINO patch space.
+
+    Fractional region coverage is pooled at native mask resolution. Patches
+    touching foreground are excluded to keep this cue separate from identity.
+    The box scales with the object independently in each view; no assumption
+    that left/right relations survive a viewpoint change is made.
+    """
+    if expansion <= 1 or min_patches <= 0:
+        raise ValueError("expansion must exceed 1 and min_patches must be positive")
+    if features.ndim != 3 or mask.squeeze().ndim != 2:
+        raise ValueError("Expected features [C,H,W] and a 2D mask")
+    mask = (mask.squeeze().to(features.device) > 0).float()
+    ys, xs = torch.where(mask > 0)
+    if not len(xs):
+        return None, 0.0
+    h, w = mask.shape
+    x0, x1 = int(xs.min()), int(xs.max()) + 1
+    y0, y1 = int(ys.min()), int(ys.max()) + 1
+    dx = max(1, math.ceil((x1-x0)*(expansion-1)/2))
+    dy = max(1, math.ceil((y1-y0)*(expansion-1)/2))
+    ring = torch.zeros_like(mask)
+    ring[max(0,y0-dy):min(h,y1+dy), max(0,x0-dx):min(w,x1+dx)] = 1
+    ring *= 1-mask
+    size = features.shape[-2:]
+    weights = F.interpolate(ring[None,None], size=size, mode="area")[0,0]
+    foreground = F.interpolate(mask[None,None], size=size, mode="area")[0,0]
+    weights = weights * (foreground <= 0.05)
+    mass = float(weights.sum())
+    if mass < min_patches:
+        return None, mass
+    pooled = (features.float()*weights).sum(dim=(-2,-1))/mass
+    norm = torch.linalg.vector_norm(pooled)
+    if not torch.isfinite(pooled).all() or norm <= 1e-8:
+        return None, mass
+    return pooled/norm, mass
+
+
+@torch.no_grad()
+def score_context(features_query, features_target, query_masks, candidates,
+                  expansions=(1.5, 2.0), min_patches=4.0):
+    """Return serializable per-object evidence; candidates contain predictions."""
+    out = []
+    for j, mask in enumerate(query_masks):
+        row = {"scores": {}, "scales": {}, "patch_mass": {}}
+        for expansion in expansions:
+            key = str(expansion)
+            q, qm = context_descriptor(features_query, mask, expansion, min_patches)
+            row["scales"][key], row["patch_mass"][key] = {}, {"query": qm}
+            for name in EXPERTS:
+                masks = candidates.get(name)
+                t, tm = (None, 0.0) if masks is None else context_descriptor(
+                    features_target, masks[j], expansion, min_patches)
+                row["patch_mass"][key][name] = tm
+                row["scales"][key][name] = (
+                    float(torch.dot(q,t).clamp(-1,1)) if q is not None and t is not None else None)
+        # All candidates use the same scale set. Missing evidence never receives
+        # a zero score, which could unfairly beat a legitimate negative cosine.
+        for name in EXPERTS:
+            vals = [row["scales"][str(s)][name] for s in expansions]
+            row["scores"][name] = sum(vals)/len(vals) if vals and all(v is not None for v in vals) else None
+        out.append(row)
+    return out
+
+
+def select_context(baseline, evidence, valid_candidates, weight=1.0, margin=0.05):
+    """Conservative residual reranker with a baseline preference margin.
+
+    Maximize weight * (context(candidate)-context(baseline)) - margin for
+    alternatives; baseline residual is zero. This preserves both original
+    direction-specific routers at weight=0. It does not pretend their learned
+    and rule-based scores have a common numerical scale.
+    """
+    if not math.isfinite(weight) or weight < 0 or not math.isfinite(margin) or margin < 0:
+        raise ValueError("weight and margin must be finite and nonnegative")
+    if weight == 0:
+        return baseline, "disabled"
+    scores = evidence.get("scores", {})
+    base = scores.get(baseline)
+    if base is None or not math.isfinite(base):
+        return baseline, "invalid_baseline_context"
+    best, gain = baseline, 0.0
+    for name in EXPERTS:
+        value = scores.get(name)
+        if name == baseline or name not in valid_candidates or value is None or not math.isfinite(value):
+            continue
+        residual = weight*(value-base)-margin
+        if residual > gain:
+            best, gain = name, residual
+    return best, "context_override" if best != baseline else "baseline_retained"
