@@ -0,0 +1,74 @@
+"""Audit and summarize paired context PCCS evaluation without fitting on labels."""
+import argparse
+from collections import Counter, defaultdict
+import hashlib
+import json
+import math
+from pathlib import Path
+
+
+def summarize(rows):
+    pairs=defaultdict(list)
+    for r in rows: pairs[r['video_id']].append(r)
+    fields={'PCCS':('IoU','Dice','shape_acc','location_score'),
+            'Context':('iou_context','dice_context','shape_acc_context','location_score_context')}
+    for e in ('visual','anchor','fusion'):
+        fields[e]=(f'iou_{e}',f'dice_{e}',f'shape_acc_{e}',f'location_score_{e}')
+    out={'pairs':len(pairs),'objects':len(rows),'object':{},'frame':{}}
+    for method,keys in fields.items():
+        out['object'][method]={m:sum(float(r[k]) for r in rows)/len(rows) for m,k in zip(('IoU','Dice','ContA','LocE'),keys)}
+        out['frame'][method]={m:sum(sum(float(r[k]) for r in rr)/len(rr) for rr in pairs.values())/len(pairs) for m,k in zip(('IoU','Dice','ContA','LocE'),keys)}
+    diffs=[r['iou_context']-r['IoU'] for r in rows]
+    out.update(changed=sum(r['context_changed'] for r in rows),
+        improved=sum(d>1e-8 for d in diffs),harmed=sum(d< -1e-8 for d in diffs),
+        reasons=dict(Counter(r['context_reason'] for r in rows)),
+        mean_oracle_gap_before=sum(r['oracle_iou']-r['IoU'] for r in rows)/len(rows),
+        mean_oracle_gap_after=sum(r['oracle_iou']-r['iou_context'] for r in rows)/len(rows))
+    return out
+
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument('jsonl',type=Path)
+    p.add_argument('--annotation',type=Path,required=True)
+    p.add_argument('--output',type=Path,required=True)
+    p.add_argument('--limit',type=int)
+    p.add_argument('--baseline-jsonl',type=Path)
+    args=p.parse_args()
+    anno=json.loads(args.annotation.read_text())
+    if args.limit: anno=dict(list(anno.items())[:args.limit])
+    expected={(str(vid),str(obj)) for vid,v in anno.items() for obj in v['objects']}
+    rows=[json.loads(s) for s in args.jsonl.read_text().splitlines() if s]
+    actual=[(str(r['video_id']),str(r['obj_id'])) for r in rows]
+    assert len(actual)==len(set(actual)), 'Duplicate object identities'
+    assert set(actual)==expected,(len(actual),len(expected),'missing or extra objects')
+    for r in rows:
+        for k in ('IoU','Dice','iou_context','dice_context','shape_acc_context','location_score_context'):
+            assert math.isfinite(r[k]) and 0<=r[k]<=1,(k,r[k])
+        chosen=r['context_expert']
+        assert abs(r['iou_context']-r['iou_'+chosen])<1e-7
+        assert r['context_changed']==(chosen!=r['best_expert'])
+    baseline_check=None
+    if args.baseline_jsonl:
+        base={(r['video_id'],r['obj_id']):r for r in map(json.loads,args.baseline_jsonl.read_text().splitlines())}
+        assert set(base)==set(actual)
+        for r in rows:
+            b=base[(r['video_id'],r['obj_id'])]
+            for k in ('best_expert','IoU','Dice','iou_visual','iou_anchor','iou_fusion'):
+                assert r[k]==b[k],(r['video_id'],k,r[k],b[k])
+        baseline_check='exact'
+    result={'annotation':str(args.annotation),'annotation_sha256':hashlib.sha256(args.annotation.read_bytes()).hexdigest(),
+            'jsonl_sha256':hashlib.sha256(args.jsonl.read_bytes()).hexdigest(),
+            'coverage':'exact','baseline_parity':baseline_check,'overall':summarize(rows),'groups':{}}
+    groups=defaultdict(list)
+    for r in rows:
+        mode=anno[r['video_id']].get('candidate_meta',{}).get('temporal_mode')
+        if mode: groups[mode].append(r)
+    result['groups']={k:summarize(v) for k,v in groups.items()}
+    result['largest_changes']=[{k:r[k] for k in ('video_id','obj_id','best_expert','context_expert','IoU','iou_context','context_evidence')} for r in sorted(rows,key=lambda r:abs(r['iou_context']-r['IoU']),reverse=True)[:20]]
+    args.output.parent.mkdir(parents=True,exist_ok=True)
+    args.output.write_text(json.dumps(result,indent=2,allow_nan=False))
+    print(json.dumps({k:v for k,v in result.items() if k!='largest_changes'},indent=2))
+
+
+if __name__=='__main__': main()
